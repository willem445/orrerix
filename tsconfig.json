{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // TypeScript auto-includes every package under node_modules/@types with
    // no "types" field set, so @types/node (added for e2e/, see
    // e2e/tsconfig.json) would otherwise leak Node's ambient globals
    // (process, Buffer, __dirname, ...) into this DOM-only program —
    // typechecking green code that throws at runtime in the browser, the
    // opposite of constraint 5's frontend/backend seam (#1428 review B1).
    // e2e/tsconfig.json's own "types" override is unaffected by this.
    "types": []
  },
  // `dev` is the fixture-replay page (#2891 S4) — a dev-only entry that drives the
  // REAL `StructuredPaneView` off a checked-in fixture so the DOM wiring can be
  // validated by hand, which is this repo's rule for DOM code. It is typechecked
  // here on purpose: a dev harness nothing compiles is a dev harness that has
  // already rotted the next time somebody reaches for it. `vite build` bundles
  // `index.html` alone, so nothing under `dev/` reaches `dist/`.
  "include": ["src", "dev"]
}
